# Copy to backend/.env and fill in. Never commit the real file — .gitignore
# already excludes .env and .env.* but keeps this example.
#
#   cp backend/.env.example backend/.env
#
# In production, set these as environment variables on the host instead of
# shipping a file. The Docker image never contains a .env.

# ─── Environment ──────────────────────────────────────────────────────────────
# "production" hides the API docs, turns on HSTS and refuses REQUIRE_AUTH=false.
ENVIRONMENT=development

# ─── Sign-in (required) ───────────────────────────────────────────────────────
# Every API request must carry the user's Supabase session token. This is the
# same project URL the frontend uses (VITE_SUPABASE_URL). Without it the API
# refuses every request.
SUPABASE_URL=https://your-project.supabase.co

# Only for Supabase projects still on the legacy shared JWT secret (Dashboard ->
# Project Settings -> JWT Keys). Projects on asymmetric signing keys - the
# default for new projects - leave this blank; they are verified with the
# public JWKS. This value is SECRET: never put it in the frontend.
SUPABASE_JWT_SECRET=

# Offline local development only. Never set false in production.
REQUIRE_AUTH=true

# ─── Credentials ──────────────────────────────────────────────────────────────
# Every key here is OPTIONAL. Leave one blank and the app asks the signed-in
# user for their own when they first need it, holding it in their browser tab
# only. A key set here always takes precedence and is used for everybody, so
# filling these in is what stops users being prompted at all.
#
# Set a key here when you are running this for other people. Leave them blank
# when each person should pay for their own usage.

# Screenshot analysis, and the voice LLM by default.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Speech-to-text for the voice feature. https://console.groq.com/keys
GROQ_API_KEY=

# Only needed when LLM_PROVIDER=anthropic. Also: pip install anthropic
# (not included in the Docker image; add it to requirements.txt to use it there).
ANTHROPIC_API_KEY=

# ─── Vision (screen analysis) ─────────────────────────────────────────────────
# Must accept image input.
OPENAI_MODEL=gpt-4.1

# Low temperature keeps generated code deterministic across retries.
VISION_TEMPERATURE=0.1
VISION_MAX_TOKENS=4096

# ─── Voice assistant ──────────────────────────────────────────────────────────
# Which provider answers spoken questions: openai | groq | anthropic
# Each reads its OWN key above, so switching provider no longer breaks vision.
LLM_PROVIDER=openai

# Must be a model id belonging to LLM_PROVIDER.
LLM_MODEL=gpt-4.1

# Speech-to-text (served by Groq).
ASR_MODEL=whisper-large-v3
# Blank to auto-detect the spoken language.
ASR_LANGUAGE=en

# ─── Image pipeline ───────────────────────────────────────────────────────────
# The vision API rescales every high-detail image so its SHORT side is 768px,
# then bills by 512px tile. Sending anything bigger is discarded; sending
# anything smaller is upscaled back into a blur at the same price. 768 is both
# the cheapest and the sharpest setting — change it only if you know why.
IMAGE_SHORT_SIDE=768

# Caps the tile count on ultrawide monitors.
IMAGE_MAX_LONG_SIDE=2048

# Screenshots are text. Below roughly 80 the JPEG ringing around small glyphs
# starts costing you correct answers.
IMAGE_JPEG_QUALITY=88

# Rejected before decoding.
MAX_IMAGE_BYTES=6291456
MAX_PDF_BYTES=10485760
MAX_PDF_PAGES=40
# One push-to-talk recording. Two minutes of Opus is well under 1 MB.
MAX_AUDIO_BYTES=10485760
# Whole-request cap, checked before the body is read. Keep deploy/Caddyfile's
# request_body max_size in step.
MAX_REQUEST_BYTES=12582912

# ─── Session state ────────────────────────────────────────────────────────────
# Pinned reference screenshots per session. Each one costs roughly 1.1k prompt
# tokens on every subsequent question, so this is the main cost dial.
MAX_CONTEXT_IMAGES=6

# Conversation messages retained (user + assistant, so 10 = 5 exchanges).
MAX_CONVERSATION_MESSAGES=10

# Idle sessions are evicted after this long.
SESSION_TTL_SECONDS=3600

# Perceptual-hash distance below which two screenshots count as the same frame.
# Raise to dedupe more aggressively, lower if near-identical frames matter.
DUPLICATE_HASH_DISTANCE=4

# Sessions hold screenshots in memory. A user over their cap loses their
# least recently used session; the server refuses new ones at the total cap.
MAX_SESSIONS_PER_USER=4
MAX_SESSIONS_TOTAL=500
# Memory all pinned screenshots may use together. Pinning is refused past it.
# Roughly a quarter of the server's RAM.
MAX_CONTEXT_BYTES_TOTAL=268435456

# ─── Rate limits (requests per user per minute) ───────────────────────────────
RATE_LIMIT_ANALYZE_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=40
RATE_LIMIT_VOICE_PER_MIN=20
RATE_LIMIT_SESSION_PER_MIN=20
RATE_LIMIT_PDF_PER_MIN=6
RATE_LIMIT_LIGHT_PER_MIN=60

# ─── Keys supplied by the browser ─────────────────────────────────────────────
# When true (the default), a user can enter their own key if this server has
# none. A server key always wins, so this can never redirect billing away from
# a configured key.
#
# Set false to refuse client-supplied keys outright. Do that if you have set a
# server key and want requests without one to fail loudly rather than prompt.
ALLOW_CLIENT_API_KEYS=true

# ─── Server ───────────────────────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API. Never "*".
# Production: CORS_ORIGINS=https://screenai.tech,https://www.screenai.tech
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=INFO
