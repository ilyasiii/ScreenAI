# Copy to backend/.env and fill in. Never commit the real file — .gitignore
# already excludes .env and .env.* but keeps this example.
#
#   cp backend/.env.example backend/.env

# ─── Vision (screen analysis) ─────────────────────────────────────────────────
# Required. Used by services/openai_vision.py for screenshot analysis.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Model for screenshot analysis. Must support image input.
OPENAI_MODEL=gpt-4.1

# ─── Voice assistant ──────────────────────────────────────────────────────────
# Which provider answers spoken questions: openai | groq | anthropic
LLM_PROVIDER=openai

# Model for the voice path. Must match LLM_PROVIDER — a Groq model id here with
# LLM_PROVIDER=openai (or the reverse) fails at the first request, not at start-up.
LLM_MODEL=gpt-4.1

# NOTE: services/voice_llm.py reads OPENAI_API_KEY for every provider, including
# groq and anthropic. To use Groq or Anthropic for voice today you have to put
# that provider's key in OPENAI_API_KEY, which then breaks vision. Until that is
# fixed, leave LLM_PROVIDER=openai.
#
# NOTE: LLM_PROVIDER=anthropic imports the `anthropic` package, which is not in
# requirements.txt. Install it first: pip install anthropic

# ─── Speech-to-text ───────────────────────────────────────────────────────────
# Required for the voice feature. Groq hosts whisper-large-v3, used by
# services/voice_transcription.py. The voice WebSocket will not work without it;
# screenshot analysis is unaffected.
# https://console.groq.com/keys
GROQ_API_KEY=gsk-your-groq-key-here

# ─── Server ───────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. Add your deployed frontend
# origin here. Do not use "*" — the API sends credentials, and browsers reject
# that combination.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
