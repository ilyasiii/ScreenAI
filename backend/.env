# Your Gemini API key - get it from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use for vision analysis
GEMINI_MODEL=gemini-2.5-flash

# Maximum number of previous screenshots to keep as context
MAX_CONTEXT_SCREENSHOTS=5

# CORS allowed origins (React dev server)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173



