# Copy to frontend/.env.local and adjust. Vite only exposes VITE_-prefixed vars.
#
#   cp frontend/.env.example frontend/.env.local
#
# Everything here is compiled into the browser bundle and is PUBLIC. Never put
# a secret here: no API keys, and never the Supabase service_role key (the
# production build refuses to run with one). The anon key is designed to be
# public; it is safe ONLY if Row Level Security is enabled on every table.
#
# For the deployed site these are set as GitHub Actions variables instead
# (see deploy/README.md).

# Backend origin. Must be https:// for a production build.
#   Local:       http://localhost:8000
#   Production:  https://api.screenai.tech
VITE_API_URL=http://localhost:8000

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
