# Copy to frontend/.env.local and adjust. Vite only exposes VITE_-prefixed vars.
#
#   cp frontend/.env.example frontend/.env.local
#
# Note: everything here is compiled into the browser bundle and is public.
# The Supabase anon key is designed for that — it is safe ONLY if Row Level
# Security is enabled on every table.

# Backend origin. The voice WebSocket URL is derived from this.
VITE_API_URL=http://localhost:8000

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: soft daily analysis cap shown in the UI. Leave unset for no cap.
# VITE_DAILY_LIMIT=100
